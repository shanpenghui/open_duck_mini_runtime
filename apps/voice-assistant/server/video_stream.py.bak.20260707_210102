from __future__ import annotations

import time
from collections.abc import Iterator
from datetime import datetime, timezone
from pathlib import Path
from threading import Event, Lock, Thread
from typing import Any


DEFAULT_VIDEO_WIDTH = 640
DEFAULT_VIDEO_HEIGHT = 480
DEFAULT_VIDEO_FPS = 15
DEFAULT_JPEG_QUALITY = 80
DEFAULT_CANDIDATES = tuple(f"/dev/video{i}" for i in range(12))
DEFAULT_COLOR_CANDIDATES = ("/dev/video4", "/dev/video2", "/dev/video6", "/dev/video0")
MJPEG_BOUNDARY = "frame"
_STREAMS_LOCK = Lock()
_STREAMS: dict[tuple[str, int, int, int, int], "SharedMjpegStream"] = {}


def video_status_payload(device: str | None = None, probe: bool = False) -> dict[str, Any]:
    cv2, cv2_error = _import_module("cv2")
    payload: dict[str, Any] = {
        "ok": True,
        "source": "realsense-mjpeg",
        "opencv_importable": cv2 is not None,
        "opencv_error": cv2_error,
        "video_devices": _list_video_devices(),
        "default_width": DEFAULT_VIDEO_WIDTH,
        "default_height": DEFAULT_VIDEO_HEIGHT,
        "default_fps": DEFAULT_VIDEO_FPS,
        "default_jpeg_quality": DEFAULT_JPEG_QUALITY,
        "stream_path": "/video/stream",
        "timestamp": _now_iso(),
        "message": "RealSense D435 color stream over OpenCV/V4L2 MJPEG. Use probe=true to briefly test opening a device.",
    }
    if cv2 is None or not probe:
        return payload

    result = _probe_capture(cv2, device=device)
    payload.update(result)
    return payload


def mjpeg_frame_generator(
    *,
    device: str | None = None,
    width: int = DEFAULT_VIDEO_WIDTH,
    height: int = DEFAULT_VIDEO_HEIGHT,
    fps: int = DEFAULT_VIDEO_FPS,
    quality: int = DEFAULT_JPEG_QUALITY,
) -> Iterator[bytes]:
    cv2, cv2_error = _import_module("cv2")
    if cv2 is None:
        raise RuntimeError(f"OpenCV is required for video streaming: {cv2_error}")

    width = _clamp_int(width, 160, 1920, DEFAULT_VIDEO_WIDTH)
    height = _clamp_int(height, 120, 1080, DEFAULT_VIDEO_HEIGHT)
    fps = _clamp_int(fps, 1, 30, DEFAULT_VIDEO_FPS)
    quality = _clamp_int(quality, 40, 95, DEFAULT_JPEG_QUALITY)

    stream = _get_shared_stream(
        cv2=cv2,
        device=device,
        width=width,
        height=height,
        fps=fps,
        quality=quality,
    )
    yield from stream.frames()


class SharedMjpegStream:
    def __init__(
        self,
        *,
        cv2: Any,
        device: str | None,
        width: int,
        height: int,
        fps: int,
        quality: int,
    ) -> None:
        self.cv2 = cv2
        self.device = device
        self.width = width
        self.height = height
        self.fps = fps
        self.quality = quality
        self.frame_interval_s = 1.0 / float(fps)
        self.encode_params = [int(cv2.IMWRITE_JPEG_QUALITY), quality]
        self.lock = Lock()
        self.frame_ready = Event()
        self.stop_requested = Event()
        self.thread: Thread | None = None
        self.latest_jpeg: bytes | None = None
        self.selected_device = device or "auto"
        self.last_error: str | None = None

    def start(self) -> None:
        with self.lock:
            if self.thread is not None and self.thread.is_alive():
                return
            self.stop_requested.clear()
            self.thread = Thread(target=self._run, name="openduck-mjpeg-stream", daemon=True)
            self.thread.start()

    def frames(self) -> Iterator[bytes]:
        self.start()
        while True:
            if not self.frame_ready.wait(timeout=5.0):
                error = self.last_error or "camera did not produce a frame in time"
                raise RuntimeError(error)

            with self.lock:
                jpeg = self.latest_jpeg
                selected_device = self.selected_device
            if jpeg is None:
                time.sleep(0.05)
                continue

            yield (
                f"--{MJPEG_BOUNDARY}\r\n"
                "Content-Type: image/jpeg\r\n"
                "Cache-Control: no-cache\r\n"
                f"X-OpenDuck-Device: {selected_device}\r\n"
                "\r\n"
            ).encode("ascii") + jpeg + b"\r\n"
            time.sleep(self.frame_interval_s)

    def _run(self) -> None:
        capture = None
        while not self.stop_requested.is_set():
            try:
                if capture is None or not capture.isOpened():
                    capture, selected_device = _open_first_readable_capture(
                        self.cv2,
                        device=self.device,
                        width=self.width,
                        height=self.height,
                        fps=self.fps,
                    )
                    with self.lock:
                        self.selected_device = selected_device
                        self.last_error = None

                loop_started = time.monotonic()
                ok, frame = capture.read()
                if not ok or frame is None:
                    with self.lock:
                        self.last_error = "camera read failed"
                    time.sleep(min(self.frame_interval_s, 0.2))
                    continue

                encoded_ok, encoded = self.cv2.imencode(".jpg", frame, self.encode_params)
                if encoded_ok:
                    with self.lock:
                        self.latest_jpeg = encoded.tobytes()
                        self.last_error = None
                    self.frame_ready.set()

                elapsed = time.monotonic() - loop_started
                if elapsed < self.frame_interval_s:
                    time.sleep(self.frame_interval_s - elapsed)
            except Exception as exc:
                with self.lock:
                    self.last_error = str(exc)
                self.frame_ready.clear()
                if capture is not None:
                    capture.release()
                    capture = None
                time.sleep(1.0)

        if capture is not None:
            capture.release()


def _get_shared_stream(
    *,
    cv2: Any,
    device: str | None,
    width: int,
    height: int,
    fps: int,
    quality: int,
) -> SharedMjpegStream:
    key = (device or "auto", width, height, fps, quality)
    with _STREAMS_LOCK:
        stream = _STREAMS.get(key)
        if stream is None:
            stream = SharedMjpegStream(
                cv2=cv2,
                device=device,
                width=width,
                height=height,
                fps=fps,
                quality=quality,
            )
            _STREAMS[key] = stream
        return stream


def _probe_capture(cv2: Any, device: str | None) -> dict[str, Any]:
    try:
        capture, selected_device = _open_first_readable_capture(
            cv2,
            device=device,
            width=DEFAULT_VIDEO_WIDTH,
            height=DEFAULT_VIDEO_HEIGHT,
            fps=DEFAULT_VIDEO_FPS,
        )
    except Exception as exc:
        return {
            "camera_available": False,
            "probe_error": str(exc),
        }

    try:
        ok, frame = capture.read()
        if not ok or frame is None:
            return {
                "camera_available": False,
                "selected_device": selected_device,
                "probe_error": "device opened but did not return a frame",
            }
        actual_height, actual_width = frame.shape[:2]
        return {
            "camera_available": True,
            "selected_device": selected_device,
            "width": int(actual_width),
            "height": int(actual_height),
        }
    finally:
        capture.release()


def _open_first_readable_capture(
    cv2: Any,
    *,
    device: str | None,
    width: int,
    height: int,
    fps: int,
) -> tuple[Any, str]:
    candidates = _candidate_devices(device)
    errors: list[str] = []

    for candidate in candidates:
        capture = _open_capture(cv2, candidate)
        keep_capture = False
        try:
            if not capture.isOpened():
                errors.append(f"{candidate}: open_failed")
                continue

            capture.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc("M", "J", "P", "G"))
            capture.set(cv2.CAP_PROP_FRAME_WIDTH, width)
            capture.set(cv2.CAP_PROP_FRAME_HEIGHT, height)
            capture.set(cv2.CAP_PROP_FPS, fps)
            capture.set(cv2.CAP_PROP_BUFFERSIZE, 1)

            frame = None
            for _ in range(5):
                ok, current = capture.read()
                if ok and current is not None:
                    frame = current
                    break
            if frame is None:
                errors.append(f"{candidate}: read_failed")
                continue

            keep_capture = True
            return capture, str(candidate)
        except Exception as exc:
            errors.append(f"{candidate}: {exc}")
        finally:
            if not keep_capture:
                capture.release()

    raise RuntimeError("No readable RealSense/UVC color device found. " + "; ".join(errors))


def _open_capture(cv2: Any, device: str) -> Any:
    if str(device).isdigit():
        return cv2.VideoCapture(int(device), cv2.CAP_V4L2)
    return cv2.VideoCapture(str(device), cv2.CAP_V4L2)


def _list_video_devices() -> list[str]:
    return [
        str(path)
        for path in sorted(Path("/dev").glob("video*"), key=_video_device_sort_key)
        if path.exists()
    ]


def _candidate_devices(device: str | None) -> list[str]:
    if device:
        return [device]

    detected = _list_video_devices()
    detected_set = set(detected)
    preferred = [item for item in DEFAULT_COLOR_CANDIDATES if item in detected_set or not detected]
    rest = [item for item in detected if item not in preferred]
    if detected:
        return _dedupe(preferred + rest)
    return _dedupe(list(DEFAULT_COLOR_CANDIDATES) + list(DEFAULT_CANDIDATES))


def _video_device_sort_key(path: Path) -> tuple[int, str]:
    name = path.name
    if name.startswith("video") and name.removeprefix("video").isdigit():
        return int(name.removeprefix("video")), name
    return 9999, name


def _dedupe(values: list[str]) -> list[str]:
    seen: set[str] = set()
    result: list[str] = []
    for value in values:
        if value not in seen:
            seen.add(value)
            result.append(value)
    return result


def _import_module(name: str) -> tuple[Any | None, str | None]:
    try:
        module = __import__(name)
    except Exception as exc:
        return None, str(exc)
    return module, None


def _clamp_int(value: int, minimum: int, maximum: int, default: int) -> int:
    try:
        return max(minimum, min(maximum, int(value)))
    except (TypeError, ValueError):
        return default


def _now_iso() -> str:
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")
