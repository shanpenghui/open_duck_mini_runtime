[Unit]
Description=Voice Assistant WebSocket Server
After=network-online.target voice-assistant-llama.service
Wants=network-online.target
Requires=voice-assistant-llama.service

[Service]
Type=simple
User=duck
Group=duck
WorkingDirectory=/home/duck/apps/voice-assistant
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/duck/apps/voice-assistant/.venv/bin/uvicorn server.app:app --host 0.0.0.0 --port 8765
Restart=always
RestartSec=5
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
