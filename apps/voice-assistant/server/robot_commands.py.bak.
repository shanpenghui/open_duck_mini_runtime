def normalize_text(text: str) -> str:
    normalized = unicodedata.normalize("NFKC", text).strip().lower()
    punctuation_pattern = (
        r"[\s,\.\!\?;:\"'\u3001\u3002\uff0c\uff01\uff1f\uff1b"
        r"\uff1a\u201c\u201d\u2018\u2019]+"
    )
    normalized = re.sub(punctuation_pattern, "", normalized)
    return _strip_fillers(normalized)


def match_robot_command(text: str) -> RobotCommand | None:
    normalized = normalize_text(text)
    if not normalized:
        return None

    if _contains_emergency(normalized):
        return COMMANDS["stop"]

    steps_command = _match_steps(normalized)
    if steps_command is not None:
        return steps_command

    command_id = PHRASE_TO_COMMAND_ID.get(normalized)
    if command_id is not None:
        return COMMANDS[command_id]

    for pattern, pattern_command_id in COMMAND_PATTERNS:
        if pattern.fullmatch(normalized):
            return COMMANDS[pattern_command_id]

    return None


def _strip_fillers(text: str) -> str:
    previous = None
    current = text
    while previous != current:
        previous = current
        for wake_word in sorted(WAKE_WORDS, key=len, reverse=True):
            if current.startswith(wake_word):
                current = current[len(wake_word):]
        for prefix in sorted(FILLER_PREFIXES, key=len, reverse=True):
            if current.startswith(prefix):
                current = current[len(prefix):]
        for suffix in sorted(FILLER_SUFFIXES, key=len, reverse=True):
            if current.endswith(suffix) and len(current) > len(suffix):
                current = current[: -len(suffix)]
    return current


def _contains_emergency(text: str) -> bool:
    if any(keyword in text for keyword in EMERGENCY_KEYWORDS):
        return True
    return text in {"\u505c", "stop", "stopit"}


def _match_steps(text: str) -> RobotCommand | None:
    direction = "forward"
    number_pattern = r"[\u4e00\u4e8c\u4e24\u4e09\u56db\u4e94\u516d\u4e03\u516b\u4e5d\u53411-9]"
    match = re.fullmatch(rf"(?:\u5411|\u5f80)?\u524d(?:\u8d70|\u8fdb)?({number_pattern})\u6b65", text)
    if not match:
        match = re.fullmatch(rf"\u524d\u8fdb({number_pattern})\u6b65", text)
    if not match:
        match = re.fullmatch(rf"(?:\u5411|\u5f80)?\u540e(?:\u9000|\u8d70)?({number_pattern})\u6b65", text)
        direction = "backward"
    if not match:
        return None

    steps = CHINESE_NUMBERS[match.group(1)]
    if steps > MAX_FORWARD_STEPS:
        return RobotCommand(
            command_id="walk_forward_steps_over_limit",
            reply_on_match="\u524d\u8fdb\u6b65\u6570\u8d85\u8fc7\u4e0a\u9650",
            params={"steps": float(steps), "max_steps": float(MAX_FORWARD_STEPS)},
        )

    lin_x = 0.15 if direction == "forward" else -0.15
    command_id = "walk_forward_steps" if direction == "forward" else "walk_backward_step"
    reply_text = (
        f"\u5df2\u8bc6\u522b\u5411\u524d\u8d70{steps}\u6b65\u547d\u4ee4"
        if direction == "forward"
        else f"\u5df2\u8bc6\u522b\u540e\u9000{steps}\u6b65\u547d\u4ee4"
    )
    return RobotCommand(
        command_id=command_id,
        reply_on_match=reply_text,
        duration_s=steps * 0.5,
        cooldown_s=1.0,
        params={"lin_x": lin_x, "steps": float(steps)},
    )
